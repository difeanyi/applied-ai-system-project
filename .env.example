# Copy this file to .env and fill in your values:  cp .env.example .env
# Never commit your real .env file (it is listed in .gitignore).

# --- LLM provider -------------------------------------------------------
# Which model interprets requests and writes explanations: "openai", "anthropic" or "gemini"
# "gemini" has a free tier (key from https://aistudio.google.com); pair it with EMBEDDING_PROVIDER=local
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# Only needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-haiku-5-5

# Only needed when LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Embeddings for the knowledge base (RAG) ----------------------------
#   "openai" - OpenAI embeddings (needs OPENAI_API_KEY)
#   "local"  - ChromaDB's built-in all-MiniLM-L6-v2 model; runs on your
#              machine with no API key (downloads ~80 MB on first use)
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Paths and tuning ---------------------------------------------------
CHROMA_PERSIST_DIR=./chroma_db
LOG_FILE=./system.log
KNOWLEDGE_TOP_K=4
RECOMMENDATIONS_K=5
LLM_TEMPERATURE=0.2
MAX_REQUEST_CHARS=500
