# Copy this file to .env and fill in your values:  cp .env.example .env
# Never commit your real .env file (it is listed in .gitignore).

# --- LLM provider -------------------------------------------------------
# Which model writes the schedule and quizzes: "openai" or "anthropic"
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# Only needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Embeddings ---------------------------------------------------------
# Anthropic does not offer an embeddings API, so choose one of:
#   "openai" - OpenAI embeddings (needs OPENAI_API_KEY)
#   "local"  - ChromaDB's built-in all-MiniLM-L6-v2 model; runs on your
#              machine with no API key (downloads ~80 MB on first use)
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Paths and tuning ---------------------------------------------------
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=study_materials
LOG_FILE=./system.log
CHUNK_SIZE_WORDS=500
CHUNK_OVERLAP_WORDS=50
RETRIEVAL_TOP_K=5
QUESTIONS_PER_TOPIC=3
MAX_UPLOAD_MB=50
LLM_TEMPERATURE=0.2
