%% TuneScout AI: system architecture
%% Extends the Module 3 Music Recommender Simulation (TuneScout 1.0).
%% Flow: plain-language request -> RAG -> agent (interpret, validate, rank, critique, explain) -> UI
%% Dashed arrows = logging and testing. Purple = humans. Orange = automated checks (evaluators).

flowchart TD
    User(["Listener<br/>types a request, e.g.<br/>'something mellow for studying'"])

    subgraph INPUT["Input guardrails"]
        Guard{"Empty or over<br/>500 characters?"}
    end

    subgraph RAG["Retriever (RAG)"]
        KB["Knowledge base<br/>genre, mood and activity guides<br/>data/knowledge/*.md"]
        Chroma[("ChromaDB<br/>40 embedded passages")]
        Retriever["Hybrid retriever<br/>exact synonyms +<br/>top 4 by meaning"]
    end

    subgraph AGENT["TuneScout agent"]
        Interpret["Interpreter LLM<br/>request + passages -> taste<br/>profile + ranking mode"]
        Validate{"Validator<br/>real catalog labels?<br/>numbers 0-1? real mode?"}
        Scorer["Original scorer (Module 3)<br/>recommender.py, unchanged<br/>ranks all 18 songs"]
        Critic{"Critic<br/>asked-for genre/mood missing?<br/>weak top score?"}
        Explain["Explainer LLM<br/>one note per song"]
        FactCheck{"Fact check<br/>mentions only<br/>recommended songs?"}
        Fallback["Scorer's own reasons<br/>(fallback)"]
    end

    Catalog[("songs.csv<br/>18 songs")]

    subgraph UI["Streamlit app"]
        Results["Interpretation, top 5, notes,<br/>agent trace, knowledge used"]
        Adjust["Adjust and re-rank<br/>(no AI)"]
    end

    Log[["system.log<br/>retrieved passages, LLM outputs,<br/>rejections, re-plans, API errors,<br/>human overrides"]]
    Dev(["Developer<br/>audits system.log"])
    Eval[["Live evaluation<br/>16 labeled requests<br/>eval/results.md"]]
    Tests[["pytest: 31 offline tests<br/>fake LLM + fake embeddings"]]

    User --> Guard
    Guard -- "rejected" --> User
    Guard -- ok --> Retriever
    KB --> Chroma --> Retriever
    Retriever -- "passages" --> Interpret
    Interpret --> Validate
    Validate -- "problems sent back<br/>(up to 3 attempts)" --> Interpret
    Validate -- "not about music" --> Results
    Validate -- valid --> Scorer
    Catalog --> Scorer
    Scorer --> Critic
    Critic -- "issues: re-plan once,<br/>keep the better result" --> Interpret
    Critic -- ok --> Explain
    Explain --> FactCheck
    FactCheck -- "retry once" --> Explain
    FactCheck -- "still failing" --> Fallback --> Results
    FactCheck -- passes --> Results
    Results --> User
    User -- "fixes what the AI got wrong" --> Adjust
    Adjust --> Scorer

    Retriever -.-> Log
    Interpret -.-> Log
    Critic -.-> Log
    Adjust -.-> Log
    Log --> Dev
    Tests -. "verifies" .-> RAG
    Tests -. "verifies" .-> AGENT
    Tests -. "verifies" .-> UI
    Eval -. "measures" .-> AGENT
    Dev --> Eval

    classDef human fill:#ede7f6,stroke:#5e35b1,color:#311b92
    classDef check fill:#fff3e0,stroke:#ef6c00,color:#e65100
    classDef store fill:#e3f2fd,stroke:#1565c0,color:#0d47a1
    classDef original fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20
    class User,Dev human
    class Guard,Validate,Critic,FactCheck,Tests,Eval check
    class Chroma,Catalog,Log,KB store
    class Scorer original
